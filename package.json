{
  "name": "@ygghq/ychrome",
  "version": "0.1.0",
  "description": "ychrome - the yggdrasilhq build, delivered by ynpm",
  "bin": {
    "ychrome": "bin/ychrome",
    "ychrome-vault": "bin/ychrome-vault"
  },
  "files": [
    "bin/",
    "finalize.mjs"
  ],
  "optionalDependencies": {
    "@ygghq/ychrome-linux-x64": "0.1.0",
    "@ygghq/ychrome-linux-arm64": "0.1.0",
    "@ygghq/ychrome-darwin-x64": "0.1.0",
    "@ygghq/ychrome-darwin-arm64": "0.1.0",
    "@ygghq/ychrome-win32-x64": "0.1.0",
    "@ygghq/ychrome-win32-arm64": "0.1.0"
  },
  "scripts": {
    "postinstall": "node ./finalize.mjs"
  },
  "yggterm": {
    "app": {
      "name": "ychrome",
      "label": "Ychrome",
      "icon": "",
      "binary": "ychrome",
      "verbs": [
        {
          "id": "new",
          "label": "New Ychrome",
          "args": [],
          "row_spawn": true
        },
        {
          "id": "incognito",
          "label": "New Ychrome (Incognito)",
          "args": ["--profile", "temp"],
          "row_spawn": true
        }
      ],
      "context_menu": {
        "enabled": true,
        "contexts": [
          "workspace",
          "session"
        ],
        "verbs": [
          "new",
          "incognito"
        ]
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yggdrasilhq/ychrome.git"
  },
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
